# Скопируйте файл в .env.local и заполните. На хостинге те же переменные
# задаются в настройках проекта. Секреты читаются только на сервере.

# Публичный адрес сайта (SEO, карта сайта, превью ссылок).
# Можно не задавать, если адрес указан в config/site.ts → url.
# Пока адрес не задан, сайт закрыт от индексации.
NEXT_PUBLIC_SITE_URL=

# Приём заказов через Telegram-бота (config/site.ts → orders.channel = 'api').
# 1. Создайте бота у @BotFather и скопируйте токен.
# 2. Добавьте бота в группу менеджеров и напишите в ней /start.
# 3. Откройте https://api.telegram.org/bot<ТОКЕН>/getUpdates и найдите "chat":{"id":-100…}.
TELEGRAM_BOT_TOKEN=
# Один или несколько чатов через запятую: -1001234567890,123456789
TELEGRAM_CHAT_ID=

# Приём заказов в CRM или любую систему через webhook.
# POST с JSON: { "event": "order.created", "idempotencyKey": "...", "order": {...}, "text": "..." }
# и заголовком Idempotency-Key (одинаков у повторов одного заказа). Только https://.
ORDER_WEBHOOK_URL=
# Необязательно: передаётся в заголовке Authorization: Bearer <значение>
ORDER_WEBHOOK_SECRET=
